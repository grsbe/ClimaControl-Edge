# Factory passwords baked into the firmware at build time.
# Copy this file to .env (which git ignores) and choose your own values.
# They apply only to a controller without a stored configuration (new or erased board);
# after that, passwords are changed in the web UI under Configuration.

# Password of the controller's own WiFi access point "ClimaControl" (8-63 characters)
CC_DEFAULT_AP_PASSWORD=change-me-please

# Password for changes in the web UI / HTTP API (user name: admin)
CC_DEFAULT_WEB_PASSWORD=change-me-please
