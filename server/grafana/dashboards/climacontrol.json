      "type": "stat",
      "title": "Last data",
      "description": "Seconds since the last status message arrived. Normally below 10.",
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"climacontrol\")\n  |> range(start: -30d, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"system\" and r._field == \"uptime_s\")\n  |> last()\n  |> map(fn: (r) => ({_time: r._time, _value: float(v: uint(v: now()) - uint(v: r._time)) / 1000000000.0}))"
        }
