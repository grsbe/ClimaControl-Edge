    {
      "type": "timeseries",
      "title": "Temperature",
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"climacontrol\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"signal\" and r.signal =~ /\\.temperature$/)\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"signal\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 1,
          "displayName": "${__field.labels.signal}",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": 60000,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
